NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public site URL — used for SEO canonical/OG tags and the sitemap. Set this to
# your real production domain once you have one.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Used by src/lib/blog/generate.ts to write the daily blog post.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Secures the daily cron endpoint (src/app/api/blog/generate/route.ts).
# Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET" when this
# env var is set on the project — just generate any long random string here.
CRON_SECRET=your-random-secret-here
